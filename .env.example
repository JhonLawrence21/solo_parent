NODE_ENV=production
PORT=10000

# PostgreSQL Database
DB_HOST=aws.connect.psdb.cloud
DB_PORT=5432
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=solo_parent_system
DB_SSL=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10485760
